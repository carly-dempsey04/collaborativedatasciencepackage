Package: collaborativedatasciencepackage
Title: Analysis Tools for Coral Reef Benthic Cover Data
Version: 0.0.0.9000
Authors@R: c(
    person("Juan Pablo", "Lozano Pena",
           email = "juanp.lozanop@austin.utexas.edu",
           role = "aut"),
